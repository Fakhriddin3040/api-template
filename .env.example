# Every setting is <PREFIX>_<FIELD>, where the prefix names the config class that
# owns it (see src/app/shared_kernel/config/). Nothing is read from an unprefixed
# variable.
#
# A *_PORT is always the port published on the host. Inside the compose network
# services talk on their standard ports (5432, 6379, 8000, 80), which compose
# sets itself — you never configure those.

# ===== APP =====
APP_ENVIRONMENT=development
# Bare public host, no scheme, no trailing slash. The scheme follows
# APP_ENVIRONMENT (http while developing, https otherwise).
APP_DOMAIN=localhost:8000
APP_TIMEZONE=UTC
# python scripts/utils/generate_secret.py
APP_SECRET_KEY=
# base64-encoded 32 bytes, same generator
APP_AES_KEY=
# Comma separated. Empty allows every origin while developing, and none in
# production — browsers refuse a wildcard together with credentials.
APP_CORS_ALLOWED_ORIGINS=
# Host port the API is published on.
APP_PORT=8000

# ===== JWT =====
# Separate from APP_SECRET_KEY: rotating it invalidates sessions and nothing else.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# seconds
JWT_ACCESS_TOKEN_LIFETIME=3600
# days
JWT_REFRESH_TOKEN_LIFETIME=30

# ===== POSTGRES =====
# These configure the client *and* the postgres container, which reads the same
# three names.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ===== REDIS =====
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional: a Redis reachable only inside the compose network needs no auth.
REDIS_PASSWORD=

# ===== SMTP =====
# All three of host/username/password, or none — a half-configured mailer fails
# on the first confirmation email instead of at startup.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=5

# ===== TELEMETRY =====
# Which process wrote a record; each container overrides it.
TELEMETRY_SERVICE=api
TELEMETRY_LOG_DIR=logs
# seconds
TELEMETRY_POLL_INTERVAL=0.5
TELEMETRY_FROM_END=true
TELEMETRY_MIN_LEVEL=INFO
TELEMETRY_TELEGRAM_MIN_LEVEL=ERROR
TELEMETRY_EXCLUDE_URL_PREFIXES=/healthcheck,/api/v1/docs,/api/v1/get-schema
TELEMETRY_POSTGRES_ENABLED=true
TELEMETRY_TELEGRAM_ENABLED=false
TELEMETRY_POSTGRES_BATCH_SIZE=200

# ===== TELEGRAM (telemetry alerts; optional) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SYSTEM_CHAT_ID=

# ===== NGINX =====
# Host port the reverse proxy is published on.
NGINX_PORT=80

# ===== COMPOSE =====
COMPOSE_PROJECT_NAME=api_template
