# ===== APPLICATION =====
ENVIRONMENT=development
# Set to any non-empty value when running outside docker (switches URLs to http://localhost)
ENV_LOCAL=1
APP_SECRET_KEY=change-me-generate-with-scripts/utils/generate_secret.py
APP_DOMAIN=localhost
APP_TIMEZONE=UTC
SERVICE_NAME=api
SERVER_PORT=8000

# Public hostnames used when building absolute URLs (bare host, no scheme).
BACKEND_HOST=localhost:8000
FRONTEND_HOST=localhost:3000

# Comma separated. Leave empty in development to allow every origin.
CORS_ALLOWED_ORIGINS=

# ===== SECURITY =====
# base64-encoded 32 bytes: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
AES_SECRET_KEY=

# ===== JWT =====
ALGORITHM=HS256
# seconds
ACCESS_TOKEN_LIFETIME=3600
# days
REFRESH_TOKEN_LIFETIME=30

# ===== DATABASE =====
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5432

# ===== REDIS =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== SMTP =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=5

# ===== TELEMETRY =====
TELEMETRY_LOG_DIR=logs
# seconds
TELEMETRY_PULL_INTERVAL=0.5
TELEMETRY_FROM_END=true
TELEMETRY_MIN_LEVEL=INFO
TELEMETRY_TELEGRAM_MIN_LEVEL=ERROR
TELEMETRY_EXCLUDE_URL_PREFIXES=/healthcheck,/api/v1/docs,/api/v1/swagger,/get-schema
TELEMETRY_POSTGRES_ENABLED=true
TELEMETRY_TELEGRAM_ENABLED=false
TELEMETRY_POSTGRES_BATCH_SIZE=200

# ===== TELEGRAM (telemetry alerts; optional) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SYSTEM_CHAT_ID=

# ===== DOCKER =====
COMPOSE_PROJECT_NAME=api_template
PROXY_INTERNAL_PORT=80
NGINX_CONF=nginx.conf
