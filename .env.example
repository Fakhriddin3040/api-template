# ===== APP =====
APP_ENVIRONMENT=development
APP_DOMAIN=localhost:8000
APP_TIMEZONE=UTC

# python scripts/utils/generate_secret.py
APP_SECRET_KEY=

# base64-encoded 32 bytes, same generator
APP_AES_KEY=YhgBkRewkHatAc4rYM7iRTyPOVM8VY5FXr8B8aaTg0u0oD3vRR

# Comma separated. Empty allows every origin while developing, and none in
# production — browsers refuse a wildcard together with credentials.
APP_CORS_ALLOWED_ORIGINS=

# Host port the API is published on.
APP_PORT=8000

# ===== JWT =====
# Separate from APP_SECRET_KEY: rotating it invalidates sessions and nothing else.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# seconds
JWT_ACCESS_TOKEN_LIFETIME=3600
# days
JWT_REFRESH_TOKEN_LIFETIME=30

# ===== POSTGRES =====
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_HOST=localhost

# Exposed port
POSTGRES_PORT=5432

# ===== REDIS =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== SMTP =====
# All or none: Each property must be declared or not
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=5

# ===== TELEMETRY =====
# Which process wrote a record; each container overrides it.
TELEMETRY_SERVICE=api
TELEMETRY_LOG_DIR=logs
# seconds
TELEMETRY_POLL_INTERVAL=0.5
TELEMETRY_FROM_END=true
TELEMETRY_MIN_LEVEL=INFO
TELEMETRY_TELEGRAM_MIN_LEVEL=ERROR
TELEMETRY_EXCLUDE_URL_PREFIXES=/healthcheck,/api/v1/docs,/api/v1/get-schema
TELEMETRY_POSTGRES_ENABLED=true
TELEMETRY_TELEGRAM_ENABLED=false
TELEMETRY_POSTGRES_BATCH_SIZE=200

# ===== TELEGRAM (telemetry alerts; optional) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SYSTEM_CHAT_ID=

# ===== COMPOSE =====
COMPOSE_PROJECT_NAME=api_template
